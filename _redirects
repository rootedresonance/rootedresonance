# Cloudflare Pages already serves /about.html at /about and 301s the .html form
# to the clean URL. Any rule mapping /about -> /about.html therefore loops forever.
# Only Wix paths that do NOT collide with a clean URL belong here.
/about-1                 /about             301
/service-page/*          /services          301
/book-online             /contact           301
/booking-calendar/*      /contact           301
/post/*                  /blog              301
/privacy-policy          /privacy           301
/terms-and-conditions    /terms             301
/accessibility-statement /accessibility     301
/pricing-plans/list      /services          301
/services-7              /services          301

# Framework stage pages moved from /rooted-resonace-framework/<stage> (note the
# original Wix typo) to clean top-level slugs. Specific rules first, wildcard
# catch-all last so it only fires for a stage/spelling we didn't anticipate.
/rooted-resonace-framework/awaken*     /awaken      301
/rooted-resonace-framework/understand* /understand  301
/rooted-resonace-framework/reconnect*  /reconnect   301
/rooted-resonace-framework/become*     /become      301
/rooted-resonace-framework/relate*     /relate      301
/rooted-resonace-framework             /framework   301
/rooted-resonace-framework/*           /framework   301
